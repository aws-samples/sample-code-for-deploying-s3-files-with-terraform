#!/bin/bash
set -euo pipefail

# Install the S3 Files client (amazon-efs-utils 3.0.0+ provides the s3files mount helper)
dnf install -y amazon-efs-utils

mkdir -p ${mount_point}

# Mount with the S3 Files mount helper (TLS and IAM auth are always applied)
mount -t s3files ${file_system_id}:/ ${mount_point}

# Persist the mount across reboots
echo "${file_system_id}:/ ${mount_point} s3files _netdev 0 0" >> /etc/fstab
